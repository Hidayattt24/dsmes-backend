# Never ship secrets or local artifacts into the image.
.env
.env.*
*.pem
*.key

# Local build artifacts / tooling
tmp/
*.exe
coverage.out
coverage.html
build-errors.log
nul

# VCS
.git
.gitignore

# Generated docs are regenerated by `swag init` inside the build stage.
docs/docs.go
docs/swagger.yaml
