# ─────────────────────────────────────────────────────────────────────────────
# DSMES Backend — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Secrets ─────────────────────────────────────────────────────
# NEVER commit the real .env file — it contains DB passwords and JWT secrets.
# Commit .env.example instead.
.env
.env.local
.env.*.local
*.pem
*.key

# ── Build Artifacts ───────────────────────────────────────────────────────────
tmp/
dist/
bin/
*.exe
*.out

# ── Test & Coverage ───────────────────────────────────────────────────────────
coverage.out
coverage.html
*.test

# ── Swagger Generated Files ───────────────────────────────────────────────────
# These are regenerated by `make swag` — no need to track them.
docs/docs.go
docs/swagger.json
docs/swagger.yaml

# ── Air ───────────────────────────────────────────────────────────────────────
build-errors.log

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# Local Docker override files (developer-specific).
docker-compose.override.yml

#skill
.agents/

# ── Local Seeds ───────────────────────────────────────────────────────────────
cmd/seed/