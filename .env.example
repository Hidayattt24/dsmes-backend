# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME=DSMES Backend
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
# Comma-separated list of allowed CORS origins in production/staging.
# Leave empty to fall back to APP_BASE_URL.
APP_ALLOWED_ORIGINS=
# Application timezone (WIB default). Used in DB session, logger, and history.
APP_TIMEZONE=Asia/Jakarta
APP_READ_TIMEOUT=5s
APP_WRITE_TIMEOUT=10s
APP_IDLE_TIMEOUT=120s

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dsmes_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_SSLMODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME_MINUTES=60

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────
# MUST be a random secret >= 32 chars in staging/production — the app refuses
# to start with the default value in non-development environments.
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
JWT_ISSUER=dsmes-backend

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=console

# ─────────────────────────────────────────────────────────────────────────────
# Swagger
# ─────────────────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_HOST=localhost:8080

# ─────────────────────────────────────────────────────────────────────────────
# Resend
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# AI Assistant
# ─────────────────────────────────────────────────────────────────────────────
AI_CHATBOT=
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash-latest
# Persist full AI prompts (may contain patient health data) to ai_prompt_logs.
# Keep false unless you explicitly need prompt audit trails.
AI_LOG_PROMPTS=false

